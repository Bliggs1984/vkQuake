+static NVSDK_NGX_DLSS_Hint_Render_Preset ToNGXRenderPreset(RgRenderDlssPreset preset)
+{
+    switch (preset)
+    {
+        case RG_RENDER_DLSS_PRESET_TRANSFORMER_K: return NVSDK_NGX_DLSS_Hint_Render_Preset_K;
+        case RG_RENDER_DLSS_PRESET_TRANSFORMER_L: return NVSDK_NGX_DLSS_Hint_Render_Preset_L;
+        case RG_RENDER_DLSS_PRESET_TRANSFORMER_M: return NVSDK_NGX_DLSS_Hint_Render_Preset_M;
+        case RG_RENDER_DLSS_PRESET_DEFAULT:
+        default:                                  return NVSDK_NGX_DLSS_Hint_Render_Preset_Default;
+    }
+}
+
+void RTGL1::DLSS::ApplyRenderPresetHints(RgRenderDlssPreset preset) const
+{
+    if (pParams == nullptr)
+    {
+        return;
+    }
+
+    // DLSS 4 / 4.5: the network is chosen per quality mode via these hints.
+    // Preset_Default lets the nvngx_dlss.dll decide (K for DLAA/Quality/Balanced,
+    // M for Performance, L for Ultra Performance with a 310.5+ DLL).
+    const unsigned int p = static_cast<unsigned int>(ToNGXRenderPreset(preset));
+
+    NVSDK_NGX_Parameter_SetUI(pParams, NVSDK_NGX_Parameter_DLSS_Hint_Render_Preset_DLAA,             p);
+    NVSDK_NGX_Parameter_SetUI(pParams, NVSDK_NGX_Parameter_DLSS_Hint_Render_Preset_UltraQuality,     p);
+    NVSDK_NGX_Parameter_SetUI(pParams, NVSDK_NGX_Parameter_DLSS_Hint_Render_Preset_Quality,          p);
+    NVSDK_NGX_Parameter_SetUI(pParams, NVSDK_NGX_Parameter_DLSS_Hint_Render_Preset_Balanced,         p);
+    NVSDK_NGX_Parameter_SetUI(pParams, NVSDK_NGX_Parameter_DLSS_Hint_Render_Preset_Performance,      p);
+    NVSDK_NGX_Parameter_SetUI(pParams, NVSDK_NGX_Parameter_DLSS_Hint_Render_Preset_UltraPerformance, p);
+}
