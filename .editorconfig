root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h,cpp,hpp,inl}]
indent_style = tab
indent_size = 4

[*.{yml,yaml,json,md}]
indent_style = space
indent_size = 2

[*.{ps1,cmd,bat}]
end_of_line = crlf

[{*.vcxproj,*.vcxproj.filters,*.sln,*.props}]
end_of_line = crlf
indent_style = space
indent_size = 2
